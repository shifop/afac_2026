{
  "category_id": "insurance",
  "category_name": "保险合同检索",
  "description": "兜底类别，用于保险合同内容的全方位检索，覆盖合同条款文本、实体名称、定义描述以及合同主体间的关系三元组。",
  "fields": [
    {
      "field_name": "query_text",
      "field_type": "string",
      "description": "全文搜索内容，对保险合同所有文本进行模糊匹配",
      "target_index_field": "name",
      "match_method": "fuzzy",
      "weight": 1.0,
      "required": true
    },
    {
      "field_name": "entity_name",
      "field_type": "string",
      "description": "保险合同实体名称匹配，如保险人、投保人、被保险人、受益人、保险标的、险种名称、产品名称、贷款，缴费等",
      "target_index_field": "name",
      "match_method": "fuzzy",
      "weight": 0.8,
      "required": false
    },
    {
      "field_name": "subject",
      "field_type": "string",
      "description": "关系主语匹配，指向合同权利与义务的承担主体，如保险人、投保人、被保险人、受益人",
      "target_index_field": "subject",
      "match_method": "fuzzy",
      "weight": 0.4,
      "required": false
    },
    {
      "field_name": "predicate",
      "field_type": "string",
      "description": "关系谓语匹配，描述主体与客体之间的行为或权利义务关系，如承担、缴纳、享有、免除、赔付、通知等",
      "target_index_field": "predicate",
      "match_method": "fuzzy",
      "weight": 0.4,
      "required": false
    },
    {
      "field_name": "object",
      "field_type": "string",
      "description": "关系宾语匹配，代表合同中具体的权利义务客体或要素，如保险责任、保险费、保险金、免赔额、等待期、现金价值等",
      "target_index_field": "object",
      "match_method": "fuzzy",
      "weight": 0.4,
      "required": false
    },
    {
      "field_name": "section_title",
      "field_type": "string",
      "description": "**合同功能主题匹配**。请不要直接猜测原始合同的章节标题，而是将问题归纳到一个或多个标准的功能语义类别中。如果问题明确提及了某个具体章节名，可直接使用该名称。可选功能主题列表（优先从以下列表中选择，可组合使用，用中文描述）：\n- “保险责任范围” (涉及保障什么、赔什么)\n- “责任免除情形” (涉及不赔、免责、拒赔、不保什么)\n- “投保人/被保险人义务” (涉及如实告知、通知、缴费等)\n- “保险金申请与理赔流程” (涉及怎么赔、材料、时效)\n- “合同效力与解除” (涉及退保、终止、解除)\n- “保险费缴纳” (涉及缴费方式、宽限期、欠缴后果)\n- “现金价值与借款” (涉及退保金、保单贷款)\n- “等待期与保险期间” (涉及生效日、等待期、保障期限)\n- “释义与定义” (涉及专业名词解释)",
      "target_index_field": "section_title",
      "match_method": "fuzzy",
      "weight": 0.6,
      "required": false
    }
  ],
  "filters": [
    {
      "field_name": "desc",
      "field_type": "string",
      "description": "保险产品的发行公司或机构以及保险产品名称",
      "target_index_field": "desc",
      "match_method": "fuzzy",
      "weight": 1.0,
      "required": true
    }
  ],
  "default_channel_weights": {
    "entity_channel": 0.2,
    "relation_channel": 0.2,
    "title_channel": 0.4,
    "content_channel": 0.2
  }
}
