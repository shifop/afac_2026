{
  "category_id": "business_dev",
  "category_name": "业务板块发展",
  "description": "提取业务板块发展类问题的关键信息",
  "fields": [
    {
      "field_name": "entity_name",
      "field_type": "string",
      "description": "公司名称或业务板块名称",
      "target_index_field": "entity_names",
      "match_method": "exact_then_fuzzy",
      "weight": 0.9,
      "required": true
    },
    {
      "field_name": "time",
      "field_type": "string",
      "description": "年份或时间指示词，如'2025年'、'去年'",
      "target_index_field": "section_title",
      "match_method": "substring",
      "weight": 0.8,
      "required": false
    },
    {
      "field_name": "relation_predicate",
      "field_type": "string",
      "description": "关系谓词，如'发展重点'、'规划'",
      "target_index_field": "relation_predicates",
      "match_method": "fuzzy",
      "weight": 0.7,
      "required": false
    }
  ],
  "default_channel_weights": {
    "entity_channel": 0.45,
    "relation_channel": 0.25,
    "title_channel": 0.25,
    "content_channel": 0.05
  }
}