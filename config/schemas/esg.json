{
  "category_id": "esg",
  "category_name": "ESG与荣誉",
  "description": "提取ESG与荣誉类问题的关键信息",
  "fields": [
    {
      "field_name": "entity_name",
      "field_type": "string",
      "description": "公司名称或业务板块名称",
      "target_index_field": "entity_names",
      "match_method": "exact_then_fuzzy",
      "weight": 0.7,
      "required": false
    },
    {
      "field_name": "esg_aspect",
      "field_type": "string",
      "description": "ESG方面，如'评级'、'环保'、'社会责任'",
      "target_index_field": "relation_predicates",
      "match_method": "fuzzy",
      "weight": 0.9,
      "required": true
    },
    {
      "field_name": "time",
      "field_type": "string",
      "description": "年份或时间指示词",
      "target_index_field": "section_title",
      "match_method": "substring",
      "weight": 0.5,
      "required": false
    }
  ],
  "default_channel_weights": {
    "entity_channel": 0.25,
    "relation_channel": 0.4,
    "title_channel": 0.2,
    "content_channel": 0.15
  }
}