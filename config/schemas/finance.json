{
  "category_id": "finance",
  "category_name": "财务数据查询",
  "description": "提取财务数据查询类问题的关键信息",
  "fields": [
    {
      "field_name": "entity_name",
      "field_type": "string",
      "description": "公司名称或业务板块名称",
      "target_index_field": "entity_names",
      "match_method": "exact_then_fuzzy",
      "weight": 0.8,
      "required": true
    },
    {
      "field_name": "metric",
      "field_type": "string",
      "description": "财务指标名称，如'营收'、'净利润'、'毛利率'",
      "target_index_field": "relation_predicates",
      "match_method": "fuzzy",
      "weight": 0.9,
      "required": true
    },
    {
      "field_name": "time",
      "field_type": "string",
      "description": "年份或时间指示词",
      "target_index_field": "section_title",
      "match_method": "substring",
      "weight": 0.6,
      "required": false
    }
  ],
  "default_channel_weights": {
    "entity_channel": 0.35,
    "relation_channel": 0.35,
    "title_channel": 0.2,
    "content_channel": 0.1
  }
}